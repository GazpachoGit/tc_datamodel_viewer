@startuml
class Child {
  names : String[] {maxStringLength=128}
  severity : Integer {lowerBoundValue=0, upperBoundValue=10}
  amount : Double {upperBoundValue=100}
  approved : Boolean
  description : LongString
  approver : TypedReference {typedRefClassName=GroupMember}
  reference : UntypedReference
  created : Date
  note : String {maxStringLength=64}
  releases : Date[]
}
class Parent {
  code : String {maxStringLength=32}
}
class Root {
}
class External {
  owner : TypedReference {typedRefClassName=User}
}
Parent <|-- Child
Root <|-- Parent
@enduml
